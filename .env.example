# ============================================================
# ORTAM DEĞİŞKENLERİ - ÖRNEK DOSYA (.env.example)
# Gerçek değerleri .env.local'a kopyalayın.
# Bu dosyayı ASLA gerçek değerlerle doldurmayın!
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (E-posta gönderimi)
RESEND_API_KEY=

# WhatsApp numarası (Uluslararası formatta, örn: 905551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
